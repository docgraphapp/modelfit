{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MMF",
  "version": "0.1.0",
  "identifier": "app.mmf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MMF",
        "width": 940,
        "height": 800,
        "minWidth": 560,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 23 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/docgraphapp/modelfit/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBRDZBQjE3NTA3NDJFQ0MKUldUTUxuUlFGNnZXbWgwVWx5NzUwMi85RjRUWXU5L25CK1BxdnpDT1ZiL05RQ2VsRTVNQ01HbysK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 DocGraph (docgraph.app). MIT License.",
    "resources": ["resources/THIRD-PARTY-NOTICES.md"],
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
